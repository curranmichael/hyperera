# Neon Postgres pooled connection string (use the -pooler host).
# Branch: br-fancy-credit-a6crw9om
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Shared secret protecting /api/ingest. Vercel Cron sends it as a Bearer token.
# Generate one with: openssl rand -hex 32
CRON_SECRET="replace-me"

# Vercel AI Gateway key for `npm run images:generate` (story cover generation).
# Get one at: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY="replace-me"
