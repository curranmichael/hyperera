# Neon Postgres pooled connection string (use the -pooler host).
# Branch: br-fancy-credit-a6crw9om
#
# Must also be set in Vercel's *Build* environment, not just Production: the issue
# and story routes query it from generateStaticParams while the site is built.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Optional, for local scripts only. lib/db prefers it over DATABASE_URL whenever it
# is present. The weekly routine does NOT need it: it reads /api/week and publishes
# through git (the Vercel build writes the issue). Leave it unset there.
# HYPERERA_DATABASE_URL="postgresql://ROUTINE_USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Shared secret protecting /api/ingest and /api/triage. Once it is set, Vercel Cron
# sends it as a Bearer token on its own.
# Generate one with: openssl rand -hex 32
CRON_SECRET="replace-me"

# Vercel AI Gateway key. Used by the daily triage route and by
# `npm run images:generate` (story cover generation).
# Get one at: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY="replace-me"

# Optional override for the daily triage model (defaults to anthropic/claude-sonnet-5).
# TRIAGE_MODEL="anthropic/claude-sonnet-5"

# --- The weekly routine's cloud environment ---------------------------------
#
# The Friday routine reads the week from the live site, sources and generates
# images, and publishes through git, so its cloud environment needs only
# AI_GATEWAY_API_KEY — no database credential — plus these hosts under Custom
# network access (the default allowlist covers package registries and GitHub only):
#
#   upload.wikimedia.org, commons.wikimedia.org  analogy artwork (dither-art)
#   ai-gateway.vercel.sh                         generated covers
#   www.hyperera.news                            week:candidates, post-deploy check
#
# Cloud environments have no secrets store and their variables are readable by
# anyone using the environment — another reason the database credential stays in
# Vercel only.
